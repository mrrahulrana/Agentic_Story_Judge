# Copy this file to .env and fill in the values you use.
# .env is gitignored. Never commit API keys.

# Optional LangSmith tracing. Set LANGSMITH_TRACING=true and add a key to enable it.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Story_Judge

# Ollama models. Names ending in :cloud run through Ollama Cloud and need `ollama signin`.
STORYTELLER_MODEL=qwen2.5:1.5b
JUDGE_MODEL=gemma4:cloud
REWRITER_MODEL=gemma4:cloud
